# Keeps a lumen running without a window from login on, so that `lumen`
# opens its first window at once instead of starting the GPU first.
#
#   systemctl --user enable --now lumen
#
# packaging/install.sh and scripts/install.sh install and enable it with the
# path to their program.

[Unit]
Description=lumen terminal, waiting for its first window
Documentation=https://vaspyyy.github.io/lumen/docs/launching/

[Service]
ExecStart=/usr/bin/lumen --daemon
# A daemon whose program was updated ends when it has no windows, and the new
# one takes its place.
Restart=always
RestartSec=1
# What runs in its terminals is the user's, not the service's: a tmux server or
# a job started with nohup outlives the daemon, as it outlives any terminal.
# Stopping the service ends only lumen; its terminals close with it.
KillMode=process
# A program in a tab that runs out of memory is that program's end, not lumen's.
OOMPolicy=continue

[Install]
WantedBy=default.target
