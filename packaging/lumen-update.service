# Updates lumen and the tools made for it (glint, crux, recap, seek, pulse) to
# their newest releases. lumen-update.timer starts it once a day.
#
# packaging/install.sh and scripts/install.sh install it with the path to
# their program.

[Unit]
Description=Update lumen and its tools
Documentation=https://vaspyyy.github.io/lumen/docs/install/#updates
# three starts at most within two hours: the first and the two below
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/lumen update --notify
# in the background: whatever else runs, a game say, comes first
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# The run after a day the computer was off comes at login, when the network
# may not be there yet. When only the network failed, lumen update ends with
# 75 and is tried again half an hour later, twice at most. A failure that would
# come again the same way (status 1) is said once instead.
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=30min
TimeoutStartSec=1h
