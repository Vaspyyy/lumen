# Updates lumen and the tools made for it (glint, crux, recap, seek, pulse) to
# their newest releases. lumen-update.timer starts it once a day.
#
# packaging/install.sh and scripts/install.sh install it with the path to
# their program.

[Unit]
Description=Update lumen and its tools
Documentation=https://vaspyyy.github.io/lumen/docs/install/#updates
# tried again (below) at most three times a day
StartLimitIntervalSec=1d
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/lumen update --notify
# in the background: whatever else runs, a game say, comes first
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# The run after a day the computer was off comes at login, when the network
# may not be there yet: once more half an hour later.
Restart=on-failure
RestartSec=30min
TimeoutStartSec=1h
