<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: no cloud backup, no device-to-device transfer.
     The paired PCs are useless without their keys, which never leave the
     phone's secure hardware anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
