---
// The docs' search: Pagefind's index, made when the site is built, behind a
// field that opens with Ctrl+K.
import { url } from '../lib/url';
---

<dialog class="sx" data-search data-bundle={url('/pagefind/pagefind.js')} aria-label="Search the docs">
  <div class="sx-box">
    <div class="sx-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
        ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
      >
      <label class="sr-only" for="sx-input">Search the docs and the release notes</label>
      <input
        id="sx-input"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="sx-results"
        aria-autocomplete="list"
        placeholder="Search the docs and the release notes"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        data-search-input
      />
      <kbd aria-hidden="true">Esc</kbd>
    </div>
    <ul class="sx-results" id="sx-results" role="listbox" aria-label="Results" data-search-results></ul>
    <p class="sx-hint" role="status" data-search-hint>Try “prewarm”, “copy a file” or “opacity”.</p>
    <p class="sr-only" role="status" data-search-count></p>
  </div>
</dialog>

<style is:global>
  .sx {
    width: min(640px, calc(100vw - 28px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 90px auto auto;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: rgba(23, 21, 34, 0.92);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    color: var(--fg);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 40px 120px -20px rgba(0, 0, 0, 0.9),
      0 0 120px -30px rgba(255, 190, 110, 0.25);
    overflow: hidden;
  }
  .sx[open] {
    display: flex;
    animation: sx-in 0.18s ease-out;
  }
  .sx::backdrop {
    background: rgba(6, 5, 10, 0.6);
    backdrop-filter: blur(3px);
  }
  @keyframes sx-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
  }
  .sx-box {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }
  .sx-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 56px;
    flex: none;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.2s;
  }
  .sx-field:focus-within {
    border-bottom-color: rgba(255, 201, 122, 0.5);
  }
  .sx-field svg {
    width: 18px;
    height: 18px;
    color: var(--fg-3);
    flex: none;
  }
  .sx-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 16px;
  }
  .sx-field input::placeholder {
    color: var(--fg-4);
  }
  .sx-field input::-webkit-search-cancel-button {
    display: none;
  }
  .sx-field kbd {
    font-size: 11px;
    color: var(--fg-3);
  }
  .sx-results {
    margin: 0;
    padding: 8px;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sx-results:empty {
    display: none;
  }
  .sx-results a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
  }
  .sx-results li[aria-selected='true'] a {
    background: rgba(255, 201, 122, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 201, 122, 0.22);
  }
  .sx-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 15px;
    font-weight: 550;
    color: var(--fg);
  }
  .sx-title small {
    font-size: 12.5px;
    font-weight: 400;
    color: var(--fg-4);
  }
  .sx-excerpt {
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--fg-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sx-excerpt mark {
    background: none;
    color: var(--accent);
    font-weight: 550;
  }
  .sx-hint {
    padding: 16px 18px 18px;
    color: var(--fg-4);
    font-size: 14px;
  }
  .sx-hint[hidden] {
    display: none;
  }
</style>

<script>
  type SubResult = { url: string; title: string; excerpt: string; locations?: number[] };
  type Result = { url: string; excerpt: string; meta: { title?: string }; sub_results?: SubResult[] };
  type Pagefind = {
    init(): Promise<void>;
    debouncedSearch(query: string, options?: object, wait?: number): Promise<{ results: { data(): Promise<Result> }[] } | null>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const hint = dialog.querySelector<HTMLElement>('[data-search-hint]')!;
  const count = dialog.querySelector<HTMLElement>('[data-search-count]')!;
  const firstHint = hint.textContent ?? '';

  let loading: Promise<Pagefind | null> | null = null;
  let selected = 0;
  /** The query that the list on the screen answers. */
  let shown = '';
  /** Enter came before the answer to what is typed: follow it when it arrives. */
  let eager = false;

  function load(): Promise<Pagefind | null> {
    loading ??= (async () => {
      try {
        const found: Pagefind = await import(/* @vite-ignore */ dialog.dataset.bundle!);
        await found.init();
        return found;
      } catch {
        // The index is made when the site is built: a development server has
        // none. Not remembered, so a failure of the network is tried again.
        loading = null;
        return null;
      }
    })();
    return loading;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    void load();
  }

  function say(text: string) {
    hint.textContent = text;
    hint.hidden = false;
  }

  function empty() {
    list.replaceChildren();
    shown = '';
    count.textContent = '';
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
  }

  function select(index: number) {
    const options = [...list.children];
    if (!options.length) return;
    selected = (index + options.length) % options.length;
    options.forEach((option, i) => option.setAttribute('aria-selected', String(i === selected)));
    input.setAttribute('aria-activedescendant', options[selected].id);
    options[selected].scrollIntoView({ block: 'nearest' });
  }

  function follow() {
    list.children[selected]?.querySelector('a')?.click();
  }

  async function search() {
    const query = input.value.trim();
    eager = false;
    if (!query) {
      empty();
      say(firstHint);
      return;
    }
    const engine = await load();
    if (input.value.trim() !== query) return;
    if (!engine) {
      empty();
      say('The search index is made when the site is built, and this copy has none.');
      return;
    }
    const found = await engine.debouncedSearch(query, {}, 90);
    // null: a newer search has started since
    if (!found) return;
    const pages = await Promise.all(found.results.slice(0, 7).map((result) => result.data()));
    if (input.value.trim() !== query) return;
    if (!pages.length) {
      empty();
      shown = query;
      say(`Nothing found for “${query}”.`);
      return;
    }
    list.replaceChildren(
      ...pages.map((page, i) => {
        // the part of the page with the most matches, when it is under a heading of its own
        const parts = [...(page.sub_results ?? [])].sort((a, b) => (b.locations?.length ?? 0) - (a.locations?.length ?? 0));
        const part = parts[0] && parts[0].url !== page.url ? parts[0] : null;
        const item = document.createElement('li');
        item.id = `sx-option-${i}`;
        item.setAttribute('role', 'option');
        const link = document.createElement('a');
        link.href = part?.url ?? page.url;
        // the field keeps the focus: the arrow keys and Enter choose
        link.tabIndex = -1;
        const title = document.createElement('div');
        title.className = 'sx-title';
        title.textContent = page.meta.title ?? 'lumen';
        if (part) {
          const where = document.createElement('small');
          where.textContent = part.title;
          title.append(where);
        }
        const excerpt = document.createElement('div');
        excerpt.className = 'sx-excerpt';
        // Pagefind's excerpt is the page's own text, escaped, with <mark> around the matches
        excerpt.innerHTML = part?.excerpt ?? page.excerpt;
        link.append(title, excerpt);
        item.append(link);
        return item;
      }),
    );
    shown = query;
    hint.hidden = true;
    input.setAttribute('aria-expanded', 'true');
    count.textContent = pages.length === 1 ? '1 result' : `${pages.length} results`;
    select(0);
    if (eager) follow();
  }

  document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open));

  document.addEventListener('keydown', (event) => {
    const typing = (event.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((event.key === 'k' && (event.ctrlKey || event.metaKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });

  input.addEventListener('input', () => void search());
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      select(selected + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      select(selected - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      // what is listed may still answer an older query: then wait for the answer to this one
      if (shown === input.value.trim()) follow();
      else eager = true;
    }
  });

  list.addEventListener('pointermove', (event) => {
    const item = (event.target as HTMLElement).closest('li');
    if (item) select([...list.children].indexOf(item));
  });
  list.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) dialog.close();
  });
  dialog.addEventListener('close', () => {
    eager = false;
  });

  // a click beside the box closes it
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
