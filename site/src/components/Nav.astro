---
import { site } from '../data/site';
import { url } from '../lib/url';

const path = Astro.url.pathname;
const links = [
  { label: 'Features', href: url('/#features'), on: false },
  { label: 'Docs', href: url('/docs/'), on: path.startsWith(url('/docs/')) },
  { label: 'Releases', href: url('/releases/'), on: path.startsWith(url('/releases/')) },
];
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="lumen, the front page">
      <img src={url('/icon-96.png')} width="28" height="28" alt="" />
      <span>lumen</span>
    </a>

    <nav class="links" aria-label="Site">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.on ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button class="search" type="button" data-search-open aria-label="Search the docs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
        >
        <span>Search</span>
        <kbd>Ctrl K</kbd>
      </button>
      <a class="icon" href={site.repo} aria-label="lumen on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          ></path></svg
        >
      </a>
      <button class="menu" type="button" data-menu aria-expanded="false" aria-controls="nav-sheet" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="sheet" id="nav-sheet" hidden>
    <div class="wrap">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.on ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href={site.repo}>GitHub</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 10, 17, 0.62);
    backdrop-filter: saturate(150%) blur(16px);
    -webkit-backdrop-filter: saturate(150%) blur(16px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--line);
    background: rgba(11, 10, 17, 0.78);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--nav-h);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .brand img {
    border-radius: 7px;
    filter: drop-shadow(0 0 10px rgba(255, 190, 110, 0.35));
  }
  .links {
    display: flex;
    gap: 4px;
    margin-right: auto;
  }
  .links a {
    padding: 7px 12px;
    border-radius: 9px;
    font-size: 14.5px;
    color: var(--fg-3);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .links a:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.05);
  }
  .links a[aria-current='page'] {
    color: var(--fg);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 36px;
    padding: 0 8px 0 11px;
    border-radius: 10px;
    font-size: 14px;
    color: var(--fg-3);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }
  .search:hover {
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .search svg {
    width: 15px;
    height: 15px;
  }
  .search span {
    padding-right: 26px;
  }
  .search kbd {
    font-size: 11px;
    padding: 1px 6px;
    color: var(--fg-3);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--fg-3);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .icon:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
  }
  .icon svg {
    width: 19px;
    height: 19px;
  }
  .menu {
    display: none;
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }
  .menu span {
    position: absolute;
    left: 10px;
    right: 10px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--fg);
    transition:
      transform 0.25s ease,
      top 0.25s ease;
  }
  .menu span:first-child {
    top: 14px;
  }
  .menu span:last-child {
    top: 21px;
  }
  .menu[aria-expanded='true'] span:first-child {
    top: 17.5px;
    transform: rotate(45deg);
  }
  .menu[aria-expanded='true'] span:last-child {
    top: 17.5px;
    transform: rotate(-45deg);
  }
  .sheet {
    border-top: 1px solid var(--line);
    padding: 10px 0 16px;
  }
  .sheet a {
    display: block;
    padding: 11px 2px;
    font-size: 17px;
    color: var(--fg-2);
    border-bottom: 1px solid var(--line);
  }
  .sheet a:last-child {
    border-bottom: 0;
  }
  .sheet a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .brand {
      margin-right: auto;
    }
    .menu {
      display: block;
    }
    .search span,
    .search kbd {
      display: none;
    }
    .search {
      width: 36px;
      padding: 0;
      justify-content: center;
      background: none;
      box-shadow: none;
    }
    .search svg {
      width: 18px;
      height: 18px;
    }
    .icon {
      display: none;
    }
  }
  @media (min-width: 761px) {
    .sheet {
      display: none !important;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const sheet = document.getElementById('nav-sheet');

  const scrolled = () => nav?.toggleAttribute('data-scrolled', window.scrollY > 8);
  scrolled();
  window.addEventListener('scroll', scrolled, { passive: true });

  const show = (open: boolean) => {
    menu?.setAttribute('aria-expanded', String(open));
    if (sheet) sheet.hidden = !open;
  };
  menu?.addEventListener('click', () => show(menu.getAttribute('aria-expanded') !== 'true'));
  sheet?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) show(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
      show(false);
      menu.focus();
    }
  });
</script>
