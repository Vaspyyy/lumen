---
// The page of one version's note, of lumen or of a tool: the note, the
// versions before and after, and how to get it (the slot).
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { longDate, releasesPath } from '../lib/releases';
import { url } from '../lib/url';

type Release = CollectionEntry<'releases'> | CollectionEntry<'toolReleases'>;

interface Props {
  /** lumen, or the name of a tool. */
  product: string;
  release: Release;
  newer: Release | null;
  older: Release | null;
}

const { product, release, newer, older } = Astro.props;
const { Content } = await render(release);
const name = `${product} ${release.data.version}`;
---

<Base title={`${name}: ${release.data.title}`} description={release.data.summary}>
  <div class="wrap">
    <article class="note">
      <header>
        <a class="back" href={url(releasesPath(product))} data-pagefind-ignore>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            ><path d="M13 8H3M7 4 3 8l4 4"></path></svg
          >
          All {product === 'lumen' ? '' : `${product} `}release notes
        </a>
        <p class="meta">
          <span class="version">
            {
              product !== 'lumen' && (
                <>
                  <span class="tool">{product}</span>{' '}
                </>
              )
            }
            {release.data.version}
          </span>
          <time datetime={release.data.date.toISOString().slice(0, 10)}>{longDate(release.data.date)}</time>
        </p>
        <h1>{release.data.title}</h1>
        <p class="lead">{release.data.summary}</p>
        <!-- what the search shows as the result's title: whose version it is, too -->
        <span hidden data-pagefind-meta="title">{name}: {release.data.title}</span>
      </header>
      <div class="prose" data-prose>
        <Content />
      </div>
      <footer data-pagefind-ignore>
        <div class="pager">
          {
            older ? (
              <a href={url(releasesPath(product, older.data.version))}>
                <span>The version before</span>
                <b>
                  {older.data.version}: {older.data.title}
                </b>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="next" href={url(releasesPath(product, newer.data.version))}>
                <span>The version after</span>
                <b>
                  {newer.data.version}: {newer.data.title}
                </b>
              </a>
            )
          }
        </div>
        <p class="get">
          <slot />
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .note {
    max-width: 760px;
    margin-inline: auto;
    padding-top: clamp(28px, 5vw, 56px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--fg-3);
    transition: color 0.2s;
  }
  .back:hover {
    color: var(--fg);
  }
  .back svg {
    width: 15px;
    height: 15px;
  }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 34px;
  }
  .version {
    font-family: var(--mono);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent);
    text-shadow: 0 0 30px rgba(255, 190, 110, 0.45);
  }
  .tool {
    color: var(--fg);
    text-shadow: none;
  }
  time {
    font-size: 14px;
    color: var(--fg-3);
  }
  h1 {
    margin-top: 10px;
    font-size: clamp(2rem, 4.6vw, 3rem);
    letter-spacing: -0.036em;
    line-height: 1.07;
  }
  .lead {
    margin-top: 14px;
    font-size: 1.14rem;
    line-height: 1.55;
    color: var(--fg-3);
  }
  .prose {
    margin-top: 34px;
  }
  footer {
    margin-top: 64px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pager a {
    display: block;
    padding: 14px 18px 15px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      box-shadow 0.2s,
      background 0.2s;
  }
  .pager a:hover {
    background: rgba(255, 255, 255, 0.03);
    box-shadow: inset 0 0 0 1px rgba(255, 201, 122, 0.3);
  }
  .pager .next {
    text-align: right;
  }
  .pager span {
    display: block;
    font-size: 12.5px;
    color: var(--fg-4);
  }
  .pager b {
    display: block;
    margin-top: 2px;
    font-weight: 550;
  }
  .get {
    margin-top: 22px;
    font-size: 14px;
    color: var(--fg-4);
  }
  .get :global(a) {
    color: var(--fg-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }
  .get :global(code) {
    font-family: var(--mono);
    font-size: 0.95em;
    color: var(--fg-2);
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
