---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Nothing here" description="This page does not exist." noindex>
  <div class="wrap lost">
    <p class="code">cd: no such file or directory</p>
    <h1>Nothing <span class="serif lamp-text">here</span>.</h1>
    <p>The page you asked for isn’t on this site. It may have moved.</p>
    <div class="cta">
      <a class="btn btn-lamp" href={url('/')}>To the front page</a>
      <a class="btn btn-ghost" href={url('/docs/')}>To the docs</a>
    </div>
  </div>
</Base>

<style>
  .lost {
    padding-top: clamp(70px, 14vw, 160px);
    text-align: center;
  }
  .code {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--pink);
  }
  h1 {
    margin-top: 18px;
    font-size: clamp(2.6rem, 8vw, 5rem);
    letter-spacing: -0.04em;
  }
  h1 + p {
    margin-top: 16px;
    color: var(--fg-3);
    font-size: 1.1rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }
</style>
