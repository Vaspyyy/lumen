---
import Base from '../../layouts/Base.astro';
import ReleaseList from '../../components/ReleaseList.astro';
import { allReleases } from '../../lib/releases';
import { url } from '../../lib/url';

const releases = await allReleases();
---

<Base title="Release notes" description="What each version of lumen brought, newest first." noindex>
  <ReleaseList product="lumen" notes={releases}>
    <p>
      Newest first. There is a <a href={url('/rss.xml')}>feed</a> to follow, and the{' '}
      <a href={url('/docs/roadmap/')}>roadmap</a> says what comes next. The tools of lumen's family have notes of their
      own: pick one below.
    </p>
  </ReleaseList>
</Base>
