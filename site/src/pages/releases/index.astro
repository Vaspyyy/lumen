---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allReleases, longDate } from '../../lib/releases';
import { url } from '../../lib/url';

const releases = await allReleases();
const notes = await Promise.all(releases.map(async (release) => ({ release, ...(await render(release)) })));
---

<Base
  title="Release notes"
  description="What each version of lumen brought, newest first."
  noindex
>
  <div class="wrap">
    <header class="top">
      <p class="eyebrow">Release notes</p>
      <h1>What each version <span class="serif lamp-text">brought</span>.</h1>
      <p>
        Newest first. There is a <a href={url('/rss.xml')}>feed</a> to follow, and the{' '}
        <a href={url('/docs/roadmap/')}>roadmap</a> says what comes next.
      </p>
    </header>

    <ol class="line">
      {
        notes.map(({ release, Content }, i) => (
          <li>
            <div class="when">
              <a class="version" href={url(`/releases/${release.data.version}/`)}>
                {release.data.version}
              </a>
              <time datetime={release.data.date.toISOString().slice(0, 10)}>{longDate(release.data.date)}</time>
              {i === 0 && <span class="latest">Latest</span>}
            </div>
            <article>
              <h2>
                <a href={url(`/releases/${release.data.version}/`)}>{release.data.title}</a>
              </h2>
              <div class="prose">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .top {
    max-width: 720px;
    padding-top: clamp(40px, 7vw, 76px);
  }
  .top h1 {
    margin-top: 14px;
    font-size: clamp(2.1rem, 5vw, 3.3rem);
    letter-spacing: -0.038em;
    line-height: 1.05;
  }
  .top h1 .serif {
    font-size: 1.1em;
  }
  .top p:last-child {
    margin-top: 18px;
    font-size: 1.08rem;
    color: var(--fg-3);
  }
  .top a {
    color: var(--accent-2);
    text-decoration: underline;
    text-decoration-color: rgba(255, 201, 122, 0.35);
    text-underline-offset: 3px;
  }
  .line {
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
  }
  .line > li {
    display: grid;
    grid-template-columns: 200px minmax(0, 720px);
    gap: 0 clamp(24px, 4vw, 56px);
    padding-bottom: clamp(48px, 7vw, 80px);
  }
  .line > li + li {
    padding-top: clamp(48px, 7vw, 80px);
    border-top: 1px solid var(--line);
  }
  .when {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
    align-self: start;
    display: grid;
    justify-items: start;
    gap: 8px;
  }
  .version {
    font-family: var(--mono);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-shadow: 0 0 30px rgba(255, 190, 110, 0.45);
  }
  time {
    font-size: 14px;
    color: var(--fg-3);
  }
  .latest {
    padding: 2px 10px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 550;
    color: var(--green);
    background: rgba(143, 223, 168, 0.1);
  }
  article h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }
  article h2 a:hover {
    color: var(--accent-2);
  }
  .prose {
    margin-top: 18px;
  }
  .prose :global(h2) {
    margin-top: 1.8em;
    font-size: 1.14rem;
  }
  @media (max-width: 760px) {
    .line > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .when {
      position: static;
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }
    .version {
      font-size: 1.4rem;
    }
  }
</style>
