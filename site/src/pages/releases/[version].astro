---
import ReleaseNote from '../../components/ReleaseNote.astro';
import { allReleases } from '../../lib/releases';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const releases = await allReleases();
  return releases.map((release, i) => ({
    params: { version: release.data.version },
    props: { release, newer: releases[i - 1] ?? null, older: releases[i + 1] ?? null },
  }));
}

const { release, newer, older } = Astro.props;
---

<ReleaseNote product="lumen" release={release} newer={newer} older={older}>
  To get this version or a newer one, follow <a href={url('/docs/install/')}>Install</a>. The changes themselves are in
  the <a href={`${site.repo}/commits/main`}>history on GitHub</a>.
</ReleaseNote>
