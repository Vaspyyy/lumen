---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const names = Object.fromEntries(docs.map((doc) => [doc.id, doc.data.nav ?? doc.data.title]));
  return docs.map((doc) => ({
    params: { slug: doc.id === 'index' ? undefined : doc.id },
    props: { doc, names },
  }));
}

const { doc, names } = Astro.props;
const { Content, headings } = await render(doc);
---

<Docs slug={doc.id} title={doc.data.title} description={doc.data.description} headings={headings} names={names}>
  <Content />
</Docs>
